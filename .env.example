# Copy to ".env" and fill in what you need. ".env" is never pushed to GitHub.

# --- LLM for the NL-to-SQL agent (optional; blank = offline mode)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Ollama (local):    LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=llama3.1   LLM_API_KEY=ollama
LLM_BASE_URL=

# --- Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# --- Telegram (optional): create a bot with @BotFather, get chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ranking filter: minimum turnover (INR) for gainers/losers
MIN_TURNOVER_FOR_RANKING=10000000
